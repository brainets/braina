  "geminicodeassist.agentMode": true,
  "geminicodeassist.agentYoloMode": false,
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "fetch": {
  	"command": "uvx",
 	 "args": ["mcp-server-fetch"]
    },
    "braina": {
      "command": "uv",
      "args": ["run", "/home/INT/brovelli.a/code/braina/mcp/braina_mcp.py"]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "github_pat_token"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
